# Copy this file to .env and fill in real values. Never commit .env.
# Secrets are read from .env only, never hardcoded (see CLAUDE.md).

# --- Application ---
APP_ENV=development

# --- PostgreSQL ---
POSTGRES_USER=etsy
POSTGRES_PASSWORD=change-me
POSTGRES_DB=etsy_assistant
# Async URL used by the app (asyncpg). Host is the compose service name.
DATABASE_URL=postgresql+asyncpg://etsy:change-me@postgres:5432/etsy_assistant

# --- Redis (queue: arq) ---
REDIS_URL=redis://redis:6379/0

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me
# Fernet key for token encryption (REQUIRED for the Etsy OAuth token storage).
# BACK THIS UP: lose it and every stored Etsy token becomes unreadable.
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=change-me
# Mints invite codes and issues temporary passwords. Leave EMPTY to disable
# those endpoints entirely — unset means off, not open.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=
# Session cookie lifetime in days, renewed on every request.
SESSION_TTL_DAYS=30
# Send the session cookie only over HTTPS. MUST be true in production.
SESSION_COOKIE_SECURE=false
# Per-tenant daily Etsy budget. 5 tenants x 1000 = the 5000/day app ceiling.
TENANT_DAILY_QUOTA=1000

# --- Hardening ---
# Header carrying the real client IP. Behind Cloudflare set cf-connecting-ip;
# leave empty to use the socket peer. Never X-Forwarded-For: clients can forge it.
CLIENT_IP_HEADER=
# Per-client request ceilings (general, then login/register/admin).
RATE_LIMIT_REQUESTS=1200
RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_REQUESTS=20
AUTH_RATE_LIMIT_WINDOW_SECONDS=900
# Upload limits: per file, per batch, and decoded pixels (decompression bombs).
MAX_UPLOAD_BYTES=26214400
MAX_BATCH_BYTES=1073741824
MAX_IMAGE_PIXELS=60000000

# --- Etsy Open API v3 ---
# ETSY_CLIENT_ID = keystring, ETSY_CLIENT_SECRET = shared secret.
# The x-api-key header sent to Etsy is "{keystring}:{shared_secret}".
ETSY_CLIENT_ID=
ETSY_CLIENT_SECRET=
# OAuth 2.0 (PKCE). Redirect URI must match the one registered with Etsy.
ETSY_REDIRECT_URI=http://localhost:8000/api/auth/etsy/callback
ETSY_SCOPES=listings_r listings_w shops_r shops_w
# Where the OAuth callback sends the browser back to.
FRONTEND_URL=http://localhost:3000

# --- LLM provider (Anthropic) for vision + content generation ---
# Leave empty to disable content generation (the API returns 503 for it).
LLM_API_KEY=
LLM_MODEL=claude-haiku-4-5-20251001

# --- Storage / UI ---
# Object storage root (compose mounts a volume at /data/storage).
STORAGE_DIR=/data/storage
# Global app-wide daily Etsy API budget (Personal App = 5000/day).
GLOBAL_DAILY_LIMIT=5000
# Shown in the UI footer (ToU requires a visible support email).
SUPPORT_EMAIL=support@example.com

# --- Operator, as named in the Terms of Service and Privacy Policy ---
# APP_ENV=production refuses to start while any of these is empty, or while
# SUPPORT_EMAIL is still an @example.com address.
OPERATOR_NAME=
# City and country, e.g. "Istanbul, Türkiye"
OPERATOR_LOCATION=
# The law governing the Terms, e.g. "the Republic of Türkiye"
GOVERNING_LAW=
# Where disputes are heard, e.g. "the courts of Istanbul"
DISPUTE_VENUE=
# Browser origins allowed to call the API directly (comma-separated).
CORS_ORIGINS=http://localhost:3000

# --- Draft listing / thumbnail / sizes (Etsy client step) ---
# THUMBNAIL_MODE: crop (centre-crop to square, no added border — default) or pad.
THUMBNAIL_MODE=crop
THUMBNAIL_PADDING_PCT=8
THUMBNAIL_SIZE=2000
AUTO_CREATE_SECTIONS=false
DEFAULT_QUANTITY=999
