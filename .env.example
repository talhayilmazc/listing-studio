# Copy this file to .env and fill in real values. Never commit .env.
# Secrets are read from .env only, never hardcoded (see CLAUDE.md).

# --- Application ---
APP_ENV=development

# --- PostgreSQL ---
POSTGRES_USER=etsy
POSTGRES_PASSWORD=change-me
POSTGRES_DB=etsy_assistant
# Async URL used by the app (asyncpg). Host is the compose service name.
DATABASE_URL=postgresql+asyncpg://etsy:change-me@postgres:5432/etsy_assistant

# --- Redis (queue: arq) ---
REDIS_URL=redis://redis:6379/0

# --- Security (used later for encrypted token storage) ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me
# Fernet key for token encryption; generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=change-me

# --- Etsy Open API v3 (leave empty until OAuth step) ---
ETSY_CLIENT_ID=
ETSY_CLIENT_SECRET=
