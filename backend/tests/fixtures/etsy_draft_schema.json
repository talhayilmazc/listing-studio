     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "scale_id": {
     "type": "integer",
     "minimum": 1,
     "format": "int64"
    }
   }
  }
 },
 "_source": "Etsy Open API v3 OpenAPI file (developer documentation), request bodies only, read 2026-11-21",
 "updateListingInventory": {
  "content_type": "application/json",
  "schema": {
   "type": "object",
   "required": [
    "products"
   ],
   "properties": {
    "products": {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "offerings"
      ],
      "properties": {
       "sku": {
        "type": "string",
        "nullable": true
       },
       "property_values": {
        "type": "array",
        "items": {
         "type": "object",
         "required": [
          "property_id",
          "value_ids",
          "values"
         ],
         "properties": {
          "property_id": {
           "type": "integer",
           "minimum": 1
          },
          "value_ids": {
           "type": "array",
           "items": {
            "type": "integer",
            "minimum": 1
           }
          },
          "scale_id": {
           "type": "integer",
           "minimum": 1,
           "nullable": true
          },
          "property_name": {
           "type": "string"
          },
          "values": {
           "type": "array",
           "items": {
            "type": "string"
           }
          }
         }
        }
       },
       "offerings": {
        "type": "array",
        "items": {
         "type": "object",
         "required": [
          "price",
          "quantity",
          "is_enabled",
          "readiness_state_id"
         ],
         "properties": {
          "price": {
           "type": "number"
          },
          "quantity": {
           "type": "integer"
          },
          "is_enabled": {
           "type": "boolean"
          },
          "readiness_state_id": {
           "type": "integer",
           "minimum": 1,
           "nullable": true
          }
         }
        }
       }
      }
     }
    },
    "price_on_property": {
     "type": "array",
     "items": {
      "type": "integer"
     }
    },
    "quantity_on_property": {
     "type": "array",
     "items": {
      "type": "integer"
     }
    },
    "sku_on_property": {
     "type": "array",
     "items": {
      "type": "integer"
     }
    },
    "readiness_state_on_property": {
     "type": "array",
     "nullable": true,
     "items": {
      "type": "integer",
      "minimum": 1
     }
    }
   }
  }
 }
}