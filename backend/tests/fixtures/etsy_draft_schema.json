 "updateListingPersonalization": {
  "content_type": "application/json",
  "schema": {
   "type": "object",
   "required": [
    "personalization_questions"
   ],
   "properties": {
    "personalization_questions": {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "question_text",
       "question_type",
       "required"
      ],
      "properties": {
       "question_id": {
        "type": "integer",
        "minimum": 1,
        "nullable": true,
        "format": "int64"
       },
       "question_text": {
        "type": "string"
       },
       "instructions": {
        "type": "string",
        "nullable": true
       },
       "question_type": {
        "type": "string",
        "enum": [
         "text_input",
         "dropdown",
         "unlabeled_upload",
         "labeled_upload"
        ]
       },
       "required": {
        "type": "boolean"
       },
       "max_allowed_files": {
        "type": "integer",
        "nullable": true,
        "format": "int64"
       },
       "max_allowed_characters": {
        "type": "integer",
        "nullable": true,
        "format": "int64"
       },
       "options": {
        "type": "array",
        "nullable": true,
        "items": {
         "type": "object",
         "required": [
          "label"
         ],
         "properties": {
          "option_id": {
           "type": "integer",
           "minimum": 1,
           "nullable": true,
           "format": "int64"
          },
          "label": {
           "type": "string"
          }
         }
        }
       },
       "add_on_price": {
        "type": "number",
        "nullable": true,
        "format": "float"
       }
      }
     }
    }
   }
  }
 },
 "updateListingProperty": {
  "content_type": "application/x-www-form-urlencoded",
