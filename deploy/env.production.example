# Production environment (production-spec F3). Copy to /opt/listyro/.env on the
# server, fill in, then run deploy/preflight.sh before the first start.
#
# Comments are always on their own line: a trailing "# note" after a value may
# be read as part of the value, depending on the compose version.
#
# Every secret below must be NEW — generated for production with
# deploy/generate-secrets.sh, never copied from a development machine.
# `chmod 600 .env`; it is read by docker compose and nothing else.

APP_ENV=production

# --- Database ------------------------------------------------------------
POSTGRES_USER=listyro
# generate-secrets.sh (hex: safe inside the URL below)
POSTGRES_PASSWORD=
POSTGRES_DB=listyro
DATABASE_URL=postgresql+asyncpg://listyro:<POSTGRES_PASSWORD>@postgres:5432/listyro

REDIS_URL=redis://redis:6379/0

# --- Secrets ---------------------------------------------------------------
# ENCRYPTION_KEY encrypts every seller's Etsy tokens. BACK IT UP somewhere other
# than this server and other than the database backups (a password manager).
# Lose it and every stored token is unreadable; store it beside the backups and
# a stolen backup reveals every token.
# generate-secrets.sh
ENCRYPTION_KEY=
# generate-secrets.sh; used only by deploy/admin.sh
ADMIN_TOKEN=
# SECRET_KEY is read by the settings but currently used by nothing; set it anyway
# so no default ever ships. There is no SESSION_SECRET: sessions are random
# server-side tokens in Redis, not signed cookies, so there is nothing to sign.
# generate-secrets.sh
SECRET_KEY=

# --- Public addresses ------------------------------------------------------
FRONTEND_URL=https://listyro.com
CORS_ORIGINS=https://listyro.com
ETSY_REDIRECT_URI=https://api.listyro.com/api/auth/etsy/callback

# --- Behind Cloudflare -------------------------------------------------------
# The real client IP. Without this, every visitor shares the tunnel's address
# for rate limiting and the login lockout.
CLIENT_IP_HEADER=cf-connecting-ip
# HTTPS only; the browser never sends the session over plain HTTP.
SESSION_COOKIE_SECURE=true

# --- Etsy Open API v3 ------------------------------------------------------
ETSY_CLIENT_ID=
ETSY_CLIENT_SECRET=
ETSY_SCOPES=listings_r listings_w shops_r shops_w

# --- Anthropic ---------------------------------------------------------------
LLM_API_KEY=
LLM_MODEL=claude-haiku-4-5-20251001

# --- Operator, as named in the Terms and Privacy Policy --------------------
# The app refuses to start in production while any of these is empty.
SUPPORT_EMAIL=
OPERATOR_NAME=
OPERATOR_LOCATION=
GOVERNING_LAW=
DISPUTE_VENUE=

# --- Quotas and limits (defaults shown) -----------------------------------
GLOBAL_DAILY_LIMIT=5000
TENANT_DAILY_QUOTA=1000
MAX_UPLOAD_BYTES=26214400
MAX_BATCH_BYTES=1073741824
MAX_IMAGE_PIXELS=60000000

# --- Optional ------------------------------------------------------------------
# Error reports to Sentry. Empty = off, and then the Privacy Policy does not
# mention Sentry. Set it and the policy names Sentry automatically.
SENTRY_DSN=

# --- Listing behaviour (unchanged from development) ------------------------
THUMBNAIL_MODE=crop
THUMBNAIL_PADDING_PCT=8
THUMBNAIL_SIZE=2000
AUTO_CREATE_SECTIONS=false
DEFAULT_QUANTITY=999
